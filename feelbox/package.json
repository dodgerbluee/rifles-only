{
  "name": "rifles-feelbox",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev:full": "node server/dev.mjs",
    "start": "node server/dev.mjs",
    "server": "node server/start.mjs",
    "lobby": "node server/lobby.mjs",
    "game": "npx tsx server/game.ts",
    "build": "tsc --noEmit && vite build && vite build --config vite.game.config.ts",
    "docker": "docker compose up --build"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "tsx": "^4.20.5",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
